# PropelusAI Environment Variables
# Copy this file to .env.local for development or .env.production for production

# MongoDB Atlas connection string
MONGODB_URI=
# MongoDB database name
MONGODB_DB_NAME=propelus

# JWT authentication secret (use a strong random 64+ character string)
JWT_SECRET=
# JWT token expiry duration
JWT_EXPIRES_IN=24h
# Bcrypt hashing rounds for passwords
BCRYPT_ROUNDS=12

# Google Gemini API key for AI chatbot
GEMINI_API_KEY=
# SendGrid API key for transactional emails
SENDGRID_API_KEY=
# Email sender address
EMAIL_FROM=noreply@propelusai.com
# Email recipient for contact form notifications
EMAIL_TO=contact@propelusai.com

# Public site URL (http://localhost:3000 for dev, https://www.propelusai.com for prod)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API base URL (same as site URL since API routes are inside Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Rate limiting: time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Rate limiting: max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Admin panel route secret (used in URL path for admin access)
ADMIN_ROUTE_SECRET=propelusaiadminpanel279

# Google Tag Manager container ID
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA4_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=
