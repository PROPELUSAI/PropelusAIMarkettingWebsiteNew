# ─────────────────────────────────────────────
# PropelusAI Admin Panel — Environment Variables
# Copy this file to .env and fill in real values.
# ─────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────
# Atlas connection string (or local mongodb://localhost:27017)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (default: propelus)
MONGODB_DB_NAME=propelus

# ── Express Server ───────────────────────────
# Port the API server listens on (default: 5001)
SERVER_PORT=5001

# ── JWT Authentication ───────────────────────
# Secret used to sign access & refresh tokens
JWT_SECRET=change-me-to-a-random-string

# ── Resend (Email) ───────────────────────────
# API key from https://resend.com  (leave blank to skip email sending)
RESEND_API_KEY=re_your_resend_api_key_here
# "From" address shown in newsletter emails
RESEND_FROM_EMAIL=newsletter@yourdomain.com
# "From" display name
RESEND_FROM_NAME=PropelusAI

# ── Supabase (GA4 Edge Function proxy) ───────
# Only needed if the Analytics page is in use
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Google Analytics 4 ───────────────────────
VITE_GA4_PROPERTY_ID=your_ga4_property_id
VITE_GA4_API_ENDPOINT=https://your-project.supabase.co/functions/v1/analytics
